# Copy this file to .env. Never commit .env.
# All values below are local demo values. No real secret is needed.

# Application mode: local | test
APP_ENV=local
# Log level for JSON logs: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Enable simulator endpoints. Keep false outside the demo.
DEMO_MODE=true
# Agent brain: fake | anthropic | openai | openrouter
# "fake" is the offline scripted model. It needs no key and no network (default).
# A real provider needs its key below and a network. Your conversation data goes to that provider.
LLM_PROVIDER=fake
# Optional model name. Defaults: claude-haiku-5-5 | gpt-5.4-mini | nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL=
# Seconds to wait for the provider. A large free model can need 60. A live demo wants a fast model.
LLM_TIMEOUT_SECONDS=30
# true: if the provider fails, answer with the offline model. Use false only to test a provider.
LLM_FALLBACK=true
# Keys. Fill in only the provider that you choose. Never commit this file (.env is ignored by git).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# MQTT broker. The default name is the Compose service name.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Where data is kept: dynamodb | memory
STORE_BACKEND=dynamodb
# DynamoDB endpoint. Local emulator inside Compose. Empty means the real AWS endpoint.
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE=homewellness
AWS_REGION=ap-northeast-1
# FIXME: Local emulator only. In AWS use an IAM role. Never commit real keys.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
# Keep LangChain tracing off. It would call the network.
LANGSMITH_TRACING=false
# Optional image overrides. Change a tag here if a pull fails.
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.18
DYNAMODB_IMAGE=amazon/dynamodb-local:2.5.2
